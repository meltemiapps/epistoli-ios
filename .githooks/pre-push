#!/usr/bin/env bash
# Runs scripts/secret_scan.sh on what is about to be pushed. Enable once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue          # deleting a branch
  if [[ "$remote_sha" == "$zero" ]]; then
    range="origin/main..$local_sha"                   # new branch: everything not on main
  else
    range="$remote_sha..$local_sha"
  fi
  scripts/secret_scan.sh "$range" || status=1
done
exit $status
